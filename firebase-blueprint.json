{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "facility": { "type": "string" },
        "location": { "type": "string" },
        "bio": { "type": "string" },
        "is_mentor": { "type": "boolean" },
        "hide_location": { "type": "boolean" },
        "hide_history": { "type": "boolean" },
        "is_admin": { "type": "boolean" },
        "role": { "type": "string" },
        "is_suspended": { "type": "boolean" }
      },
      "required": ["id", "username", "email"]
    },
    "Thread": {
      "title": "Thread",
      "description": "Forum thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author_id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "is_flagged": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "author_id", "title", "content", "category"]
    },
    "Reply": {
      "title": "Reply",
      "description": "Forum thread reply",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "thread_id": { "type": "string" },
        "author_id": { "type": "string" },
        "content": { "type": "string" },
        "is_flagged": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "thread_id", "author_id", "content"]
    },
    "Kite": {
      "title": "Kite",
      "description": "Direct message between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "receiver_id": { "type": "string" },
        "content": { "type": "string" },
        "is_read": { "type": "boolean" },
        "read_at": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sender_id", "receiver_id", "content"]
    },
    "Document": {
      "title": "Document",
      "description": "Vault storage file",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "file_name": { "type": "string" },
        "file_type": { "type": "string" },
        "file_data": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "title", "category", "file_name", "file_type", "file_data"]
    },
    "Job": {
      "title": "Job",
      "description": "Felony-friendly job listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "is_felony_friendly": { "type": "boolean" },
        "posted_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "title", "company", "location", "description"]
    },
    "Housing": {
      "title": "Housing",
      "description": "Sober living/transitional housing listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "contact_info": { "type": "string" },
        "description": { "type": "string" },
        "posted_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "type", "location", "description"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "link": { "type": "string" },
        "is_read": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "user_id", "type", "content"]
    },
    "MentorshipSurvey": {
      "title": "MentorshipSurvey",
      "description": "User profile survey for mentor and mentee matchmaking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_preference": { "type": "string" },
        "interests": { "type": "array" },
        "life_goals": { "type": "array" },
        "cadence": { "type": "string" },
        "communication_style": { "type": "string" },
        "experience_level": { "type": "string" },
        "personal_statement": { "type": "string" },
        "availability_status": { "type": "string" }
      },
      "required": ["id", "user_id", "role_preference"]
    },
    "StudioSettings": {
      "title": "StudioSettings",
      "description": "Halflight Pictures Studio Console settings and production configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "studio_mark": { "type": "string" },
        "legal_name": { "type": "string" },
        "public_handle": { "type": "string" },
        "tagline": { "type": "string" },
        "headquarters": { "type": "string" },
        "founded": { "type": "string" },
        "production_title": { "type": "string" },
        "production_day": { "type": "number" },
        "production_total_days": { "type": "number" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "user_id", "legal_name", "public_handle"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "Synced Google Keep note and checklist item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "is_pinned": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "title", "content"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "mentorship_surveys/{surveyId}": {
      "schema": "MentorshipSurvey",
      "description": "Profile surveys for mentor and mentee matching"
    },
    "studio_settings/{settingId}": {
      "schema": "StudioSettings",
      "description": "Halflight Pictures Studio Console configuration"
    },
    "keep_notes/{noteId}": {
      "schema": "KeepNote",
      "description": "Google Keep notes and checklists"
    },
    "threads/{threadId}": {
      "schema": "Thread",
      "description": "Forum threads"
    },
    "threads/{threadId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "Forum thread replies"
    },
    "kites/{kiteId}": {
      "schema": "Kite",
      "description": "Direct message kites"
    },
    "documents/{docId}": {
      "schema": "Document",
      "description": "Uploaded vault documents"
    },
    "jobs/{jobId}": {
      "schema": "Job",
      "description": "Job board listings"
    },
    "housing/{houseId}": {
      "schema": "Housing",
      "description": "Housing directory options"
    },
    "notifications/{notifId}": {
      "schema": "Notification",
      "description": "User updates and notifications"
    }
  }
}
